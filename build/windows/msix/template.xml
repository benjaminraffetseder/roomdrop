<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="roomdrop.exe"
        Arguments=""
        InstallLocation="C:\Program Files\RoomDrop\RoomDrop">
    </Installer>
    <PackageInformation
        PackageName="RoomDrop"
        PackageDisplayName="RoomDrop"
        PublisherName="CN=RoomDrop"
        PublisherDisplayName="RoomDrop"
        Version="0.2.0.0"
        PackageDescription="Share files on your local network. No cloud, no accounts.">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="io.roomdrop.app"
                Description="Share files on your local network. No cloud, no accounts."
                DisplayName="RoomDrop"
                ExecutableName="roomdrop.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>RoomDrop</DisplayName>
            <PublisherDisplayName>RoomDrop</PublisherDisplayName>
            <Description>Share files on your local network. No cloud, no accounts.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="roomdrop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
